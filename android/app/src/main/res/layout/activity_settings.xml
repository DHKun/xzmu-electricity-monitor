<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页: Pixel 设置风格的分组列表, 平板上靠左右留白居中 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="?attr/collapsingToolbarLayoutLargeStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutLargeSize"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="设置">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="返回"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_side_pad"
            android:paddingEnd="@dimen/settings_side_pad"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SettingHeader"
                android:text="提醒" />

            <LinearLayout
                android:id="@+id/rowNotify"
                style="@style/SettingRow"
                android:background="@drawable/bg_group_top">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_notifications" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="低电量通知" />

                    <TextView
                        android:id="@+id/notifySub"
                        style="@style/SettingSub" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/notifySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowThreshold"
                style="@style/SettingRow"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_group_bottom">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_battery_alert" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="提醒阈值" />

                    <TextView
                        android:id="@+id/thresholdSub"
                        style="@style/SettingSub" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SettingHeader"
                android:text="外观" />

            <LinearLayout
                android:id="@+id/rowDynamic"
                style="@style/SettingRow"
                android:background="@drawable/bg_group_single">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_palette" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="跟随壁纸取色" />

                    <TextView
                        android:id="@+id/dynamicSub"
                        style="@style/SettingSub" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dynamicSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                style="@style/SettingHeader"
                android:text="桌面与后台" />

            <LinearLayout
                android:id="@+id/rowWidget"
                style="@style/SettingRow"
                android:background="@drawable/bg_group_top">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_widgets" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="添加桌面小组件" />

                    <TextView
                        style="@style/SettingSub"
                        android:text="在桌面查看电量, 可直接刷新" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowAuto"
                style="@style/SettingRow"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_group_bottom">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_schedule" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="自动查询" />

                    <TextView
                        style="@style/SettingSub"
                        android:text="约每 6 小时在后台查询一次" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SettingHeader"
                android:text="宿舍" />

            <LinearLayout
                android:id="@+id/rowRoom"
                style="@style/SettingRow"
                android:background="@drawable/bg_group_top">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_home" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="当前房间" />

                    <TextView
                        android:id="@+id/roomSub"
                        style="@style/SettingSub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRebind"
                style="@style/SettingRow"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_group_bottom">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_autorenew"
                    app:tint="?attr/colorError" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="重新绑定宿舍"
                        android:textColor="?attr/colorError" />

                    <TextView
                        style="@style/SettingSub"
                        android:text="重新登录并选择房间, 成功后替换当前绑定" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SettingHeader"
                android:text="关于" />

            <LinearLayout
                android:id="@+id/rowVersion"
                style="@style/SettingRow"
                android:background="@drawable/bg_group_top">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_info" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="版本" />

                    <TextView
                        android:id="@+id/versionSub"
                        style="@style/SettingSub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSource"
                style="@style/SettingRow"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_group_bottom">

                <ImageView
                    style="@style/SettingIcon"
                    android:src="@drawable/ic_calendar" />

                <LinearLayout style="@style/SettingTexts">

                    <TextView
                        style="@style/SettingTitle"
                        android:text="数据来源" />

                    <TextView
                        style="@style/SettingSub"
                        android:text="完美校园云缴费, 读数与登录信息仅保存在本机" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
