<?xml version="1.0" encoding="utf-8"?>
<!-- 添加小组件时的预览: 与 widget_small 相同, 填示例数据 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_home"
            android:tint="@color/widget_on" />

        <TextView
            android:id="@+id/wRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="902房间"
            android:textColor="@color/widget_on"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/wRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp">

            <ImageView
                android:id="@+id/wRefreshIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="刷新"
                android:src="@drawable/ic_refresh"
                android:tint="@color/widget_on" />

            <ProgressBar
                android:id="@+id/wBusy"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/widget_on"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="244"
            android:textColor="@color/widget_on"
            android:textSize="38sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="度"
            android:textColor="@color/widget_on_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="81"
        android:progressDrawable="@drawable/widget_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/bg_dot"
            android:tint="@color/level_ok" />

        <TextView
            android:id="@+id/wSub"
            android:layout_width="0dp"
            android:text="约可用 40 天"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:30"
            android:textColor="@color/widget_on_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
